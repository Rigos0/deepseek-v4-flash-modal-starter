{
  "$schema": "https://opencode.ai/config.json",
  "model": "modal/deepseek-v4-flash",
  "provider": {
    "modal": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek V4 Flash on Modal",
      "options": {
        "baseURL": "https://<your-app>.modal.run/v1",
        "apiKey": "{env:MODAL_PROXY_TOKEN}"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash 0731 (1x B300)",
          "limit": { "context": 262144, "output": 65536 }
        }
      }
    }
  }
}
